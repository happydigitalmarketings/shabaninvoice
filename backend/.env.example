PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shaban_billing?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend URLs (leave empty to allow all origins)
CORS_ORIGIN=https://your-frontend.vercel.app
# Set to 'true' only when serving frontend/dist from the same Express server
SERVE_FRONTEND=false

